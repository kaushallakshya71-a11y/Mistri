# Mistri Environment Configuration
# Copy this file to .env and configure for production

# JWT Secret (change this in production!)
MISTRI_SECRET=mistri-prod-jwt-secret-key-replace-this-in-production-2024

# Shop Configuration
UPI_VPA=mistri@upi
SHOP_NAME=Mistri Electronics

# WhatsApp / SMS Notifications (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# Google OAuth (required for Google Sign-In)
# Get these from https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Application Base URL (for QR codes and tracking links)
BASE_URL=http://localhost:8000
