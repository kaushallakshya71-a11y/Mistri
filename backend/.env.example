# Mistri Environment Configuration
# Copy this file to .env and configure for development / production

# JWT Secret (change this in production!)
MISTRI_SECRET=mistri-prod-jwt-secret-key-replace-this-in-production-2024

# Shop Configuration
UPI_VPA=mistri@upi
SHOP_NAME=Mistri Electrical/Electronic

# WhatsApp / SMS Notifications (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# Google OAuth 2.0 / OpenID Connect (required for "Continue with Google")
# 1. Create a project at https://console.cloud.google.com
# 2. Configure OAuth Consent Screen: User Type: External, Scopes: openid, email, profile
# 3. Create Credentials -> OAuth 2.0 Client IDs -> Web application
# 4. Add Authorized redirect URI: http://localhost:8000/api/auth/google/callback
# 5. Paste Client ID and Client Secret below:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Application Base URL (for QR codes and tracking links)
BASE_URL=http://localhost:8000
